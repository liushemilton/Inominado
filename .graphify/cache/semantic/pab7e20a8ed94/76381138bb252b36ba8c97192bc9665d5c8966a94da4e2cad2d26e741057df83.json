{"nodes": [{"id": "agents_graphify", "label": "AGENTS.md graphify Agent Instructions", "file_type": "document", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_graphify_query_first_protocol", "label": "Graphify Query-First Protocol", "file_type": "rationale", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Agents must run `graphify query` before any grep, search, or raw source read for codebase questions, and propagate that rule into every subagent prompt. Rationale: graph queries return a scoped subgraph that is usually far smaller than GRAPH_REPORT.md or raw grep output, keeping context usage low and reads targeted."}, {"id": "agents_graphify_skill_invocation", "label": "/graphify Skill Invocation Rule", "file_type": "concept", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Typing `/graphify` must load the installed graphify skill before any other action, so the canonical workflow is followed rather than ad-hoc exploration."}, {"id": "agents_graphify_incremental_update", "label": "Graphify Incremental Update After Code Changes", "file_type": "rationale", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "`graphify update .` is run after modifying code because it is AST-only and incurs no API cost, keeping the graph current cheaply. Dirty graphify-out/ files are expected and are explicitly not a reason to skip graphify; skipping is only valid when the task concerns stale or incorrect graph output or the user opts out."}, {"id": "agents_graphify_committed_graph_diff", "label": "Committed graph.json Diff Expectation", "file_type": "rationale", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "graphify-out/graph.json is rewritten whole on every build, so a large diff in a pull request is expected and must not be flagged as churn or used as grounds to skip the graph rebuild or its hooks."}, {"id": "agents_graphify_wiki_navigation", "label": "Graphify Wiki Index Navigation", "file_type": "concept", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "agents_graphify", "target": "agents_graphify_query_first_protocol", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "AGENTS.md", "source_location": null, "weight": 1.0}, {"source": "agents_graphify", "target": "agents_graphify_skill_invocation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "AGENTS.md", "source_location": null, "weight": 1.0}, {"source": "agents_graphify", "target": "agents_graphify_incremental_update", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "AGENTS.md", "source_location": null, "weight": 1.0}, {"source": "agents_graphify", "target": "agents_graphify_committed_graph_diff", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "AGENTS.md", "source_location": null, "weight": 1.0}, {"source": "agents_graphify", "target": "agents_graphify_wiki_navigation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "AGENTS.md", "source_location": null, "weight": 1.0}, {"source": "agents_graphify_query_first_protocol", "target": "agents_graphify_skill_invocation", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "AGENTS.md", "source_location": null, "weight": 0.8}, {"source": "agents_graphify_incremental_update", "target": "agent